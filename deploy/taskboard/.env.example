# Copy to .env, fill in, then chmod 600 .env. Never commit .env.
# Relay token Taskboard presents on ws://switchboard:8790/ws/relay: Switchboard's SWITCHBOARD_RELAY_WEBHOOK_SECRET.
SWITCHBOARD_RELAY_TOKEN=
# Bearer for Switchboard /mcp (publishes work.ready and notices): Switchboard's SWITCHBOARD_MCP_WEBHOOK_SECRET.
SWITCHBOARD_MCP_TOKEN=
# Bearer clients send to Taskboard /mcp. Generate it with:
#   python3 scripts/prepare_taskboard_deploy.py render --token-file <path outside the repo>
TASKBOARD_MCP_TOKEN=
# Not secrets: docker-compose.yml also reads these from .env (render prints them). Uncomment and fill in.
# SWITCHBOARD_REF=<commit>
# TASKBOARD_REF=<commit>
# SWITCHBOARD_CONFIG_SHA=<12 hex>
# TASKBOARD_CONFIG_SHA=<12 hex>
