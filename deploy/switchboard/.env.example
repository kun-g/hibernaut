# Copy to .env, fill in, then chmod 600 .env. Never commit .env.
# Relay token Hibernaut presents on wss://.../ws/relay (Hibernaut side: SWITCHBOARD_RELAY_TOKEN).
SWITCHBOARD_RELAY_WEBHOOK_SECRET=
# Bearer token for /mcp (Hibernaut side: SWITCHBOARD_MCP_TOKEN).
SWITCHBOARD_MCP_WEBHOOK_SECRET=
# GitHub webhook signing secret and API token for outbound comments.
SWITCHBOARD_GITHUB_WEBHOOK_SECRET=
SWITCHBOARD_GITHUB_TOKEN=
# Optional: post comments as a GitHub App instead (needs [outbound] github_app_owners). The key is the PEM,
# base64-encoded onto one line; when both are set, SWITCHBOARD_GITHUB_TOKEN is unused.
# SWITCHBOARD_GITHUB_APP_ID=
# SWITCHBOARD_GITHUB_APP_PRIVATE_KEY=
# Feishu event verification token and tenant access token.
SWITCHBOARD_FEISHU_WEBHOOK_SECRET=
SWITCHBOARD_FEISHU_TOKEN=
