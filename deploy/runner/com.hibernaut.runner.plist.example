<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Read-only pilot Runner as a per-user LaunchAgent. Replace /Users/YOU and the repository path, then see README.md.
  It runs in the foreground; launchd starts it at login and restarts it whenever it exits. It reads its Relay token
  from the owner-only file named in runner.toml: put no credential in EnvironmentVariables.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hibernaut.runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/workspace/runtime/repos/hibernaut/.venv/bin/python</string>
    <string>-m</string>
    <string>runner.service</string>
    <string>--config</string>
    <string>/Users/YOU/runner-pilot/runner.toml</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/YOU/workspace/runtime/repos/hibernaut/src</string>
    <key>PATH</key>
    <string>/usr/bin:/bin</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/YOU/runner-pilot</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <!-- Longer than the grace a stopped check's process group gets before SIGKILL. -->
  <key>ExitTimeOut</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/hibernaut-runner.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/hibernaut-runner.log</string>
</dict>
</plist>
