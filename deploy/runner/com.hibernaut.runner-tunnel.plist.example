<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Encrypted link to the remote agent node, on the Hibernaut host: the node's 127.0.0.1:8790 leads to this host's
  127.0.0.1:8790 (the [runner] relay). "hibernaut-runner-node" is a Host alias of ~/.ssh/config; address and account
  stay there. See REMOTE.md for the key and what the node lets it do.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hibernaut.runner-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-N</string>
    <string>-T</string>
    <string>-o</string>
    <string>BatchMode=yes</string>
    <string>-o</string>
    <string>IdentitiesOnly=yes</string>
    <string>-o</string>
    <string>StrictHostKeyChecking=yes</string>
    <string>-o</string>
    <string>ExitOnForwardFailure=yes</string>
    <string>-o</string>
    <string>ServerAliveInterval=15</string>
    <string>-o</string>
    <string>ServerAliveCountMax=3</string>
    <string>-o</string>
    <string>ConnectTimeout=15</string>
    <string>-o</string>
    <string>ForwardAgent=no</string>
    <string>-o</string>
    <string>ControlPath=none</string>
    <string>-R</string>
    <string>127.0.0.1:8790:127.0.0.1:8790</string>
    <string>hibernaut-runner-node</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>15</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/hibernaut-runner-tunnel.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/hibernaut-runner-tunnel.log</string>
</dict>
</plist>
