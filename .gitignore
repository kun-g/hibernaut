# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Tests & type checkers
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local runtime state & secrets
/hibernaut.toml
# Backups and half-written versions beside it, when a project is onboarded or its settings filled in
/hibernaut.toml.bak-*
/.hibernaut.toml.*
*.db
*.db-wal
*.db-shm
# Run logs the ledger writes beside ledger.db (logs/runs/YYYY-MM-DD/<run_id>.log)
/logs/
agent_memory/
outbox/
# Drive task attachments (gdrive.attachments_dir defaults next to the database)
/attachments/
# Open Run state for restart resume (runs_root sits next to the database); untracked files block auto-update
/runs/
.env
.env.*

# Switchboard container deployment: only templates are tracked
deploy/switchboard/.env
deploy/switchboard/switchboard.toml
deploy/switchboard/Caddyfile
!deploy/switchboard/.env.example

# Taskboard container deployment (joint stack with Switchboard): only templates are tracked
deploy/taskboard/.env
deploy/taskboard/taskboard.toml
deploy/taskboard/Caddyfile
!deploy/taskboard/.env.example
