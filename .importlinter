[importlinter]
root_packages =
    agent_runtime
    switchboard
    ccpeer
include_external_packages = True

[importlinter:contract:clean-layers]
name = Clean Architecture L0-L3 dependency direction
type = layers
layers =
    agent_runtime.app
    agent_runtime.adapters
    agent_runtime.engine
    agent_runtime.core

[importlinter:contract:engine-no-adapters]
name = Engine must never import adapters or app
type = forbidden
source_modules =
    agent_runtime.engine
forbidden_modules =
    agent_runtime.adapters
    agent_runtime.app

[importlinter:contract:models-no-ports]
name = L0 models must not import L1 ports
type = forbidden
source_modules =
    agent_runtime.core.models
forbidden_modules =
    agent_runtime.core.ports

[importlinter:contract:switchboard-zero-business-deps]
name = Switchboard must not depend on business packages
type = forbidden
source_modules =
    switchboard
forbidden_modules =
    taskboard
    agent_runtime
    runner
    memory_hub

[importlinter:contract:ccpeer-zero-business-deps]
name = ccpeer must not depend on business packages
type = forbidden
source_modules =
    ccpeer
forbidden_modules =
    taskboard
    agent_runtime
    switchboard
    runner
    memory_hub
