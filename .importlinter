[importlinter]
root_packages =
    agent_runtime
    switchboard
    ccpeer
    taskboard
include_external_packages = True

[importlinter:contract:clean-layers]
name = Clean Architecture L0-L3 dependency direction
type = layers
layers =
    agent_runtime.app
    agent_runtime.adapters
    agent_runtime.engine
    agent_runtime.core

[importlinter:contract:engine-no-adapters]
name = Engine must never import adapters or app
type = forbidden
source_modules =
    agent_runtime.engine
forbidden_modules =
    agent_runtime.adapters
    agent_runtime.app

[importlinter:contract:models-no-ports]
name = L0 models must not import L1 ports
type = forbidden
source_modules =
    agent_runtime.core.models
forbidden_modules =
    agent_runtime.core.ports

[importlinter:contract:switchboard-zero-business-deps]
name = Switchboard must not depend on business packages
type = forbidden
source_modules =
    switchboard
forbidden_modules =
    taskboard
    agent_runtime
    runner
    memory_hub

[importlinter:contract:ccpeer-zero-business-deps]
name = ccpeer must not depend on business packages
type = forbidden
source_modules =
    ccpeer
forbidden_modules =
    taskboard
    agent_runtime
    switchboard
    runner
    memory_hub

[importlinter:contract:taskboard-no-runtime-deps]
name = Taskboard must not depend on execution runtime or memory/broker internals
type = forbidden
source_modules =
    taskboard
forbidden_modules =
    agent_runtime
    runner
    hibernaut
    broker
    memory
    memory_hub

[importlinter:contract:taskboard-clean-layers]
name = Taskboard Clean Architecture app -> L3 -> L2 -> L1 -> L0 unidirectional layers
type = layers
layers =
    taskboard.app
    taskboard.adapters
    taskboard.engine
    taskboard.ports
    taskboard.core

[importlinter:contract:taskboard-core-pure]
name = Taskboard L0 core must not depend on switchboard or sqlite3
type = forbidden
source_modules =
    taskboard.core
forbidden_modules =
    sqlite3
    switchboard
    taskboard.adapters
    taskboard.engine
    taskboard.ports
