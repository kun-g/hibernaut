{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlowPlan",
  "type": "object",
  "required": ["title", "scope", "steps"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "initial_status": {
      "type": "string",
      "enum": ["backlog", "ready"],
      "default": "ready"
    },
    "template_name": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "assignee": {
            "type": "string",
            "pattern": "^(agent|human):[a-z0-9.:_-]+$",
            "default": "agent:default"
          },
          "task_type": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "description": {
            "type": "string"
          },
          "after": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
