{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hibernaut.local/schemas/runner/v1/runner.tool_authorize.schema.json",
  "title": "RunnerToolAuthorize",
  "type": "object",
  "oneOf": [
    {
      "title": "ToolCall",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "call_id", "tool_name", "args"],
      "properties": {
        "schema_version": { "const": "runner.v1" },
        "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]+$" },
        "call_id": { "type": "string", "minLength": 1 },
        "tool_name": { "type": "string", "minLength": 1 },
        "args": { "type": "object" }
      }
    },
    {
      "title": "ToolDecision",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "action", "reason"],
      "properties": {
        "schema_version": { "const": "runner.v1" },
        "action": { "enum": ["allow", "block", "defer"] },
        "reason": { "type": "string" }
      }
    }
  ]
}
