{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hibernaut.local/schemas/runner/v1/runner.run_result.schema.json",
  "title": "RunResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "runner_id",
    "status",
    "executor_id",
    "started_at",
    "ended_at",
    "duration_ms"
  ],
  "properties": {
    "schema_version": { "const": "runner.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "runner_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["succeeded", "failed", "interrupted", "timed_out", "refused"] },
    "executor_id": { "type": "string", "minLength": 1 },
    "executor_session_id": { "type": ["string", "null"] },
    "exit_code": { "type": ["integer", "null"] },
    "error_kind": {
      "type": ["string", "null"],
      "enum": [
        "rate_limit",
        "network",
        "crash",
        "timeout",
        "config_error",
        "permission_denied",
        "tool_error",
        "bad_output",
        "unknown",
        null
      ]
    },
    "error_summary": { "type": ["string", "null"] },
    "stdout_excerpt": { "type": "string", "maxLength": 262144 },
    "structured_output": { "type": ["object", "null"] },
    "log_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["runner_id", "path", "bytes"],
      "properties": {
        "runner_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": ["string", "null"] }
      }
    },
    "worktree_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["work_key"],
      "properties": {
        "work_key": { "type": "string", "minLength": 1 },
        "branch": { "type": ["string", "null"] },
        "head_sha": { "type": ["string", "null"] },
        "dirty": { "type": ["boolean", "null"] }
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 }
  }
}
