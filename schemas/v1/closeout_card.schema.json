{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hibernaut.guokun.ai/schemas/v1/closeout_card.schema.json",
  "title": "CloseoutCard",
  "type": "object",
  "required": ["schema_version", "card_id", "session_id", "agent_id", "project_key", "summary", "decisions", "status", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "card_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "project_key": { "type": "string", "minLength": 1 },
    "task_id": { "type": ["string", "null"] },
    "summary": { "type": "string", "minLength": 1 },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "title", "choice"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "choice": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "follow_up_tasks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "memory_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target_uri", "content", "reason"],
        "properties": {
          "target_uri": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "status": { "enum": ["draft", "confirmed", "synced", "discarded"] },
    "confirmed_by": { "type": ["string", "null"] },
    "confirmed_at": { "type": ["string", "null"] },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
