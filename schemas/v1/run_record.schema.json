{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kun-g/hibernaut/schemas/v1/run_record.schema.json",
  "title": "RunRecord",
  "description": "Append-only execution archive for a single Hibernaut + Runner execution cycle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "inbox_id",
    "session_id",
    "event_ids",
    "executor_id",
    "runner_id",
    "started_at",
    "ended_at",
    "duration_ms",
    "outcome_kind"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9_-]+$"
    },
    "inbox_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "event_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "executor_id": {
      "type": "string",
      "minLength": 1
    },
    "runner_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "outcome_kind": {
      "type": "string",
      "enum": [
        "silent",
        "emit",
        "suspend",
        "interrupted",
        "error"
      ]
    },
    "emit_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "done",
        "failed",
        "stopped",
        "refused",
        null
      ]
    },
    "correlation_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "replay_of_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "executor_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_kind": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "rate_limit",
        "network",
        "crash",
        "timeout",
        "config_error",
        "permission_denied",
        "tool_error",
        "bad_output",
        "unknown",
        null
      ]
    },
    "error_summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "log_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "usage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "usage_source"
      ],
      "properties": {
        "usage_source": {
          "type": "string",
          "enum": [
            "magpie",
            "cli",
            "unknown"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
